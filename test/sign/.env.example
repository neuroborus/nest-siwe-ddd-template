# Copy to .env and fill in. Do not commit .env (it is gitignored).

# Ethereum private key (with 0x prefix). Used to sign the SIWE message.
PRIVATE_KEY=0x...

# Nonce from "1 - SIWE nonce" request (Auth folder in Postman). Replace after each new nonce.
NONCE=

# Optional: SIWE message fields. Must match server config (APP_DOMAIN, APP_ORIGIN, ALLOWED_CHAIN_IDS).
DOMAIN=localhost:3000
URI=http://localhost:3000
CHAIN_ID=1
