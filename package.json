{
  "name": "nest-siwe-ddd",
  "version": "1.0.0",
  "description": "DDD + TypeORM SIWE (EIP-4361) authentication backend.",
  "author": "neuroborus",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "lint": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --testPathPattern=e2e-spec",
    "migration:generate": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.14",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "nestjs-pino": "^4.6.0",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "siwe": "^3.0.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.14",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^10.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "multer": "2.0.2",
    "form-data": "4.0.4",
    "tmp": "0.2.4",
    "brace-expansion": "2.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.(?:spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 40,
        "lines": 45,
        "statements": 50
      }
    }
  }
}
